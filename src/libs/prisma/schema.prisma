model public_files {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  size      Int
  upload_at DateTime            @default(now())
  flowers   flowers_and_files[]
}

model private_files {
  id        String   @id
  name      String   @unique
  size      Int
  upload_at DateTime @default(now())
}

model flowers {
  id         Int                            @id @default(autoincrement())
  color      String
  name_en    String
  name_ru    String
  price      Int
  variety_id Int
  history    flowers_history[]
  variety    flowers_variety                @relation(fields: [variety_id], references: [id])
  imgs       flowers_and_files[]
  farms      flowers_and_flowers_farms[]
  bouquets   flowers_and_flowers_bouquets[]
}

model flowers_variety {
  id      Int       @id @default(autoincrement())
  name_en String    @unique
  name_ru String    @unique
  flowers flowers[]
}

model flowers_history {
  id        Int     @id @default(autoincrement())
  flower_id Int
  date      Int
  price     Int
  flower    flowers @relation(fields: [flower_id], references: [id])
}

model flowers_farms {
  id      Int                         @id @default(autoincrement())
  name_en String
  name_ru String
  country String
  rate    Int
  flowers flowers_and_flowers_farms[]
}

model flowers_and_flowers_farms {
  flowers        flowers       @relation(fields: [flower_id], references: [id])
  flower_id      Int
  flowers_farms  flowers_farms @relation(fields: [flower_farm_id], references: [id])
  flower_farm_id Int

  @@id([flower_id, flower_farm_id])
}

model flowers_bouquets {
  id      Int                            @id @default(autoincrement())
  name_en String
  name_ru String
  price   Int
  flowers flowers_and_flowers_bouquets[]
}

model flowers_and_flowers_bouquets {
  flowers           flowers          @relation(fields: [flower_id], references: [id])
  flower_id         Int
  flowers_bouquets  flowers_bouquets @relation(fields: [flower_bouquet_id], references: [id])
  flower_bouquet_id Int

  @@id([flower_id, flower_bouquet_id])
}

model flowers_and_files {
  flowers          flowers      @relation(fields: [flower_id], references: [id])
  flower_id        Int
  public_files     public_files @relation(fields: [public_file_name], references: [name])
  public_file_name String

  @@id([flower_id, public_file_name])
}

model users {
  id             Int     @id @default(autoincrement())
  email          String
  email_verified Boolean @default(false)
  name           String
  password       String?
  signature      String?
  role           String  @default("user")
  oauth          String?
  oauth_id       String?
}

model users_files {
  user_id Int
  file_id Int

  @@id([user_id, file_id])
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL_PRISMA")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/libs/prisma"
}
