
model users {
  id             Int     @id @default(autoincrement())
  email          String
  email_verified Boolean @default(false)
  name           String
  password       String?
  signature      String?
  role           String  @default("user")
  oauth          String?
  oauth_id       String?
}

model users_files {
  user_id Int
  file_id Int
  @@id([user_id, file_id])
}

